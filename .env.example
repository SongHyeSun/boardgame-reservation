# 운영(Render) 환경 변수 — 이름만 적는다. 값은 Render 대시보드에만 입력하고 레포·채팅에 붙이지 않는다.
# (로컬 개발은 IntelliJ 실행 구성의 환경 변수로 필요한 것만 넣는다: ADMIN_EMAIL, ADMIN_PASSWORD, GEMINI_API_KEY 등)

SPRING_PROFILES_ACTIVE=

# Neon PostgreSQL — DB_URL 예: jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Upstash Redis (TLS) — rediss://default:<password>@<host>:6379
REDIS_URL=

# Cloudflare R2 (S3 호환) — R2_ENDPOINT 예: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 운영 관리자 시드 (SUPER_ADMIN). 로컬과 다른 강한 비밀번호를 쓴다
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 챗봇 (Gemini). 키가 비어 있으면 챗봇은 비활성(DisabledLlmClient)
GEMINI_API_KEY=
GEMINI_MODEL=

# JVM 메모리 옵션 (Dockerfile 기본값을 덮어쓸 때만)
JAVA_TOOL_OPTIONS=
